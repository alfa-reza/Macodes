# Line ending normalization: locked per platform
*.bat text eol=crlf
*.sh   text eol=lf

# Binary files: no line ending conversion
# (Windows runners default to autocrlf=true; without declaring binary,
#   jar/png/ttf etc. get corrupted by CRLF conversion → "no main manifest attribute")
*.jar     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.keystore binary
*.p12     binary
*.aab     binary
*.apk     binary
*.dmg     binary
*.msi     binary
*.deb     binary
*.zip     binary
*.gz      binary
