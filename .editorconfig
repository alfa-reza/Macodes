# Code style baseline (unified across editors/tools; ktlint is wired in, repo is public)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# Imports sorted alphabetically (auto-organized by IDE, matching official Kotlin style)
ij_kotlin_imports_layout = *
# ktlint (rules: https://pinterest.github.io/ktlint/)
# Compose @Composable functions may use UpperCamelCase names (ScreenContent/ScreenPiP etc.)
ktlint_function_naming_ignore_when_annotated_with = Composable
# No line length limit (official Kotlin style does not enforce one; string copy is naturally long)
max_line_length = off

[*.{md,yaml,yml,json}]
indent_size = 2

[Makefile]
indent_style = tab
