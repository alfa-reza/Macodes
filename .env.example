# Macodes release signing secrets template
# Usage: cp .env.example .env and fill in real values (.env and *.jks are gitignored)
# Backup location: a secure directory on this machine (never committed, never write into commits)
#
# Variable names match GitHub Actions Secrets exactly (see .github/workflows/build.yml).
# build.gradle.kts read precedence: process env vars > project root .env > keystore.properties (compat)
# Bulk-write repo-level Secrets: gh secret set --repo alfa-reza/Macodes --env-file .env
# Each entry in this file becomes an individual Secret; no ENV_FILE needs to be created.

# Keystore password (set when keytool generates the jks)
ANDROID_KEYSTORE_PASSWORD=

# Key alias (just match the entry name given by keytool -alias in the keystore)
# Note: the alias is only an internal keystore index; it does not affect validation of signed packages;
# what is truly immutable is the private key itself — once any package has been published, changing the private key prevents existing users from upgrading over the install
# An already published keystore still uses its old alias: rename it once with
# keytool -changealias -alias <old> -keystore <file> -newalias macodes (the key itself is unchanged,
# so published packages keep upgrading over the install)
ANDROID_KEY_ALIAS=macodes

# Alias password (may be the same as the keystore password)
ANDROID_KEY_PASSWORD=

# base64 encoding of macodes-release.jks (the build script decodes and uses it automatically when the jks file is missing)
# Generate: base64 -i macodes-release.jks | tr -d '\n'
ANDROID_KEYSTORE_BASE64=
