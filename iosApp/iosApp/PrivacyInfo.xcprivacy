<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Termish privacy manifest: no tracking, no data collection (local-first, no telemetry, no accounts).
	     Required-reason APIs (mandatory on the App Store since spring 2024):
	     - UserDefaults: multiplatform-settings (non-secret persistence of the host list/settings)
	     - FileTimestamp: SFTP file timestamp display + stat fallback (file attribute reading) -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: reads/writes only the app's own functional configuration (not tracking/not advertising) -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: file timestamps are displayed to the user inside the app (the modified-time
				     column of the SFTP file list) and are not passed to third parties -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
